POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expenses

# Optional — override the Spring datasource defaults
# DB_URL=jdbc:postgresql://localhost:5432/expenses
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# JWT signing key (min 32 chars). Change this before deploying to production.
JWT_SECRET=ChangeThisSecretKeyToAtLeast32BytesLongForHS256Algorithm!
# Token lifetime in milliseconds (default: 24 h)
# JWT_EXPIRATION_MS=86400000

# Admin tenant seeded on application startup. Change before deploying to production.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=adminpassword

# Tailscale auth key — generate at https://login.tailscale.com/admin/settings/keys
# Use a reusable key for persistent deployments; ephemeral for CI/CD.
TS_AUTHKEY=tskey-auth-...
