POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expenses

# Optional — override the Spring datasource defaults
# DB_URL=jdbc:postgresql://localhost:5432/expenses
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# JWT signing key (min 32 chars). Change this before deploying to production.
JWT_SECRET=ChangeThisSecretKeyToAtLeast32BytesLongForHS256Algorithm!
# Token lifetime in milliseconds (default: 24 h)
# JWT_EXPIRATION_MS=86400000
